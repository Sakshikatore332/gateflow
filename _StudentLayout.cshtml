@{
    string currentController =
        ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    string currentAction =
        ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] | GateFlow</title>

    <link rel="stylesheet"
          href="~/css/gateflow-student.css"
          asp-append-version="true" />
</head>
<body>

    <div class="app-shell">

        <aside class="sidebar">
            <a class="logo"
               asp-controller="Student"
               asp-action="Dashboard">
                <span class="logo-icon">G</span>
                <span>GateFlow<span class="logo-dot">.</span></span>
            </a>

            <div class="sidebar-label">STUDENT WORKSPACE</div>

            <nav class="nav-menu">

                <a class="nav-link @(currentController == "Student" && currentAction == "Dashboard" ? "active" : "")"
                   asp-controller="Student"
                   asp-action="Dashboard">
                    <span>▦</span> Dashboard
                </a>

                <a class="nav-link @(currentController == "GatePass" && currentAction == "Apply" ? "active" : "")"
                   asp-controller="GatePass"
                   asp-action="Apply">
                    <span>✚</span> Apply Gate Pass
                </a>

                <a class="nav-link @(currentController == "GatePass" && currentAction != "Apply" ? "active" : "")"
                   asp-controller="GatePass"
                   asp-action="MyPasses">
                    <span>▤</span> My Gate Passes
                </a>

                <a class="nav-link @(currentController == "Student" && currentAction == "Profile" ? "active" : "")"
                   asp-controller="Student"
                   asp-action="Profile">
                    <span>◉</span> My Profile
                </a>

            </nav>

            <div class="sidebar-bottom">
                <div class="side-user">
                    <div class="avatar">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "S")
                    </div>
                    <div>
                        <strong>@User.Identity?.Name</strong>
                        <small>Student Account</small>
                    </div>
                </div>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">
                    @Html.AntiForgeryToken()
                    <button class="logout-btn" type="submit">
                        Sign Out
                    </button>
                </form>
            </div>
        </aside>

        <main class="main-content">

            <header class="topbar">
                <div>
                    <span class="topbar-label">CAMPUS ACCESS PORTAL</span>
                    <h3>@ViewData["Title"]</h3>
                </div>

                <div class="topbar-right">
                    <span class="student-chip">
                        ● Student Portal
                    </span>
                    <a asp-controller="Student"
                       asp-action="Profile"
                       class="top-avatar">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "S")
                    </a>
                </div>
            </header>

            <div class="page-content">

                @if (TempData["Success"] != null)
                {
                    <div class="alert-success">
                        ✓ @TempData["Success"]
                    </div>
                }

                @RenderBody()

            </div>

        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

